APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=selgestiun
# DB_USERNAME=root
# DB_PASSWORD=


#enviroments de PUR

# ── APIs Externas (configurables por institución) ────────
FAI_DSA_URL=https://dsa.unprg.edu.pe/api
FAI_DSA_TOKEN=xxx
FAI_RENIEC_URL=https://api.reniec.gob.pe/rest
FAI_RENIEC_TOKEN=xxx
FAI_SUNEDU_URL=https://api.sunedu.gob.pe
FAI_SUNEDU_TOKEN=xxx
FAI_TURNITIN_URL=https://api.turnitin.com
FAI_TURNITIN_KEY=xxx

# ── APIs Pendientes / En Evaluación ──────────────────────
# NOTA: Banco de la Nación no tiene API pública. La validación de vouchers (DGA)
# pasará a revisión manual por la Unidad de Investigación (UI) temporalmente.
# FAI_DGA_URL=https://dga.unprg.edu.pe/api
# FAI_DGA_TOKEN=xxx

# ── Reglas académicas (sin tocar código) ─────────────────
THESIS_CREDITS_MINIMUM=160
THESIS_TURNITIN_PROJECT_MAX=30
THESIS_TURNITIN_REPORT_MAX=20
THESIS_REVIEW_DEADLINE_DAYS=15
THESIS_DEFENSE_SCHEDULE_DAYS=7

# ── 2FA ──────────────────────────────────────────────────
TWO_FACTOR_DRIVER=totp # totp | sms

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

APP_PRIMARY_COLOR=#003087
APP_PRIMARY_DARK_COLOR=#001F5C
APP_PRIMARY_LIGHT_COLOR=#1A4BA8
APP_ACCENT_COLOR=#00BFFF
APP_ACCENT_LIGHT_COLOR=#E0F7FF
APP_UNIVERSITY_LOGO_URL=/img/universidad/logo.png
APP_LOGIN_BACKGROUND_URL=/img/universidad/login-bg.png
APP_FACULTY_NAME=FACHSE
APP_UNIVERSITY_NAME=UNPRG
APP_ACADEMIC_PERIOD=2026-I

VITE_APP_NAME="${APP_NAME}"


